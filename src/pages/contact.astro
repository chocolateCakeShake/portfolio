---
import BaseLayout from '../layouts/BaseLayout.astro';

const channels = [
  {
    label: 'Email',
    value: 'abdullah6566@gmail.com',
    href: 'mailto:abdullah6566@gmail.com',
    icon: 'mail',
  },
  {
    label: 'GitHub',
    value: 'github.com/chocolateCakeShake',
    href: 'https://github.com/chocolateCakeShake',
    icon: 'github',
  },
  {
    label: 'LinkedIn',
    value: 'linkedin.com/in/abdullah6566',
    href: 'https://linkedin.com/in/abdullah6566',
    icon: 'linkedin',
  },
  {
    label: 'Phone',
    value: '+92 301 5219996',
    href: 'tel:+923015219996',
    icon: 'phone',
  },
];
---

<BaseLayout title="Contact — Abdullah" description="Get in touch with Abdullah — email, GitHub, LinkedIn, or phone.">
  <section class="contact shell">
    <div class="contact__grid">
      <div class="contact__intro">
        <p class="label">Contact</p>
        <h1 class="contact__title">Let's talk.</h1>
        <p class="contact__lede">
          Have a hard problem, a team to build, or a role that needs a
          generalist who ships? I read every message. Pick whichever channel
          suits you.
        </p>
        <dl class="contact__facts">
          <div>
            <dt class="label">Based</dt>
            <dd>Lahore, PK · UTC+5</dd>
          </div>
          <div>
            <dt class="label">Response</dt>
            <dd>Usually within a day</dd>
          </div>
        </dl>
      </div>

      <div class="contact__panel">
        <div class="contact__head">
          <span class="label">Channels</span>
        </div>
        <ul class="channels">
          {channels.map((c) => (
            <li class="channel">
              <a class="channel__link" href={c.href} rel={c.href.startsWith('http') ? 'noopener' : undefined} target={c.href.startsWith('http') ? '_blank' : undefined}>
                <span class="channel__icon" aria-hidden="true">
                  {c.icon === 'mail' && (
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
                  )}
                  {c.icon === 'github' && (
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" /></svg>
                  )}
                  {c.icon === 'linkedin' && (
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M6.94 5a1.94 1.94 0 1 1-3.88 0 1.94 1.94 0 0 1 3.88 0ZM3.4 8.5h3.1V21H3.4V8.5Zm5.06 0h2.97v1.7h.04c.41-.78 1.42-1.6 2.93-1.6 3.13 0 3.71 2.06 3.71 4.74V21h-3.1v-5.54c0-1.32-.02-3.02-1.84-3.02-1.84 0-2.12 1.44-2.12 2.92V21h-3.1V8.5Z" /></svg>
                  )}
                  {c.icon === 'phone' && (
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h4l2 5-2.5 1.5a11 11 0 0 0 6 6L15 14l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 2 6a2 2 0 0 1 2-2Z" /></svg>
                  )}
                </span>
                <span class="channel__text">
                  <span class="channel__label label">{c.label}</span>
                  <span class="channel__value">{c.value}</span>
                </span>
                <svg class="channel__arrow" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" /></svg>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact {
    min-height: calc(100dvh - var(--shell-h));
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: var(--sp-12);
  }
  .contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 440px);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
    width: 100%;
  }

  .contact__title {
    font-size: var(--fs-display);
    margin: var(--sp-3) 0 var(--sp-6);
  }
  .contact__lede {
    max-width: 46ch;
    color: var(--muted);
    font-size: clamp(1rem, 1.4vw, 1.1875rem);
    line-height: 1.65;
    margin-bottom: var(--sp-8);
  }
  .contact__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-8);
    margin: 0;
    padding-top: var(--sp-6);
    border-top: 1px solid var(--border);
  }
  .contact__facts dt {
    margin-bottom: 0.35rem;
  }
  .contact__facts dd {
    margin: 0;
    color: var(--ink);
    font-size: var(--fs-small);
    font-weight: 500;
  }

  /* Channels panel — Cloudscape container */
  .contact__panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }
  .contact__head {
    padding: var(--sp-4) var(--sp-6);
    border-bottom: 1px solid var(--border);
    background: var(--surface-sunken);
  }
  .channels {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .channel + .channel {
    border-top: 1px solid var(--border);
  }
  .channel__link {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    padding: var(--sp-4) var(--sp-6);
    color: var(--ink);
    transition: background var(--dur) var(--ease);
  }
  .channel__link:hover {
    text-decoration: none;
    background: var(--accent-wash);
  }
  .channel__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    flex-shrink: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-sunken);
    color: var(--accent-ix);
  }
  .channel__text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }
  .channel__value {
    font-size: var(--fs-small);
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .channel__arrow {
    margin-left: auto;
    color: var(--faint);
    flex-shrink: 0;
    transition: color var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .channel__link:hover .channel__arrow {
    color: var(--accent-ix);
    transform: translate(2px, -2px);
  }

  @media (max-width: 820px) {
    .contact__grid {
      grid-template-columns: 1fr;
      gap: var(--sp-8);
    }
    .contact__panel {
      max-width: 480px;
    }
  }
</style>
