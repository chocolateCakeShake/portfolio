---
const links = [
  { href: '/', label: 'Home' },
  { href: '/work', label: 'Work' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="uishell">
  <div class="uishell__inner">
    <a class="wordmark" href="/" aria-label="Home">Abdullah</a>

    <nav class="nav" id="primary-nav" aria-label="Primary" data-nav>
      {
        links.map((l) => (
          <a
            class="nav__link"
            href={l.href}
            aria-current={isActive(l.href) ? 'page' : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="uishell__right">
      <button
        class="theme-toggle"
        type="button"
        aria-label="Toggle color theme"
        data-theme-toggle
      >
        <svg class="icon icon--sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
        <svg class="icon icon--moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        </svg>
      </button>

      <button
        class="nav-burger"
        type="button"
        aria-label="Open menu"
        aria-controls="primary-nav"
        aria-expanded="false"
        data-nav-burger
      >
        <svg class="icon icon--menu" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" />
        </svg>
        <svg class="icon icon--close" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const root = document.documentElement;

    // --- Theme toggle: instant flip, no transition ---
    const themeBtn = document.querySelector('[data-theme-toggle]');
    if (themeBtn) {
      themeBtn.addEventListener('click', () => {
        const current =
          root.getAttribute('data-theme') ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light');
        const next = current === 'dark' ? 'light' : 'dark';
        // Suppress every transition for the frame the theme changes on.
        root.classList.add('theme-switching');
        root.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
        requestAnimationFrame(() =>
          requestAnimationFrame(() => root.classList.remove('theme-switching'))
        );
      });
    }

    // --- Mobile menu ---
    const burger = document.querySelector('[data-nav-burger]');
    const nav = document.querySelector('[data-nav]');
    if (burger && nav) {
      const setOpen = (open) => {
        nav.toggleAttribute('data-open', open);
        burger.setAttribute('aria-expanded', String(open));
        burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      };
      burger.addEventListener('click', () =>
        setOpen(burger.getAttribute('aria-expanded') !== 'true')
      );
      // Close on link tap and on Escape.
      nav.addEventListener('click', (e) => {
        if (e.target.closest('.nav__link')) setOpen(false);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') setOpen(false);
      });
    }
  })();
</script>

<style>
  .uishell {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--shell-h);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .uishell__inner {
    height: 100%;
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: flex;
    align-items: center;
    gap: var(--sp-6);
  }

  .wordmark {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1.375rem;
    color: var(--ink);
    letter-spacing: -0.02em;
  }
  .wordmark:hover {
    text-decoration: none;
    color: var(--accent-ix);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: var(--sp-1);
    margin-left: auto;
  }
  .nav__link {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 500;
    color: var(--muted);
    padding: var(--sp-2) var(--sp-4);
    border-radius: var(--radius);
    transition: color var(--dur) var(--ease), background var(--dur) var(--ease);
  }
  .nav__link:hover {
    color: var(--ink);
    background: var(--surface);
    text-decoration: none;
  }
  /* Active tab — a clear highlighted pill (reads for any audience) */
  .nav__link[aria-current='page'] {
    color: var(--accent-ix);
    background: var(--accent-wash);
    font-weight: 600;
  }

  .uishell__right {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
  }

  .theme-toggle,
  .nav-burger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    background: transparent;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    color: var(--muted);
    cursor: pointer;
    transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .theme-toggle:hover,
  .nav-burger:hover {
    color: var(--ink);
    border-color: var(--ink);
  }
  .icon {
    display: block;
  }
  /* Show the icon for the theme you'd switch TO: light mode → moon, dark → sun */
  .icon--sun {
    display: none;
  }
  :root[data-theme='dark'] .icon--sun {
    display: block;
  }
  :root[data-theme='dark'] .icon--moon {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .icon--sun {
      display: block;
    }
    :root:not([data-theme='light']) .icon--moon {
      display: none;
    }
  }

  /* Burger is desktop-hidden; menu/close swap on open */
  .nav-burger {
    display: none;
  }
  .icon--close {
    display: none;
  }
  .nav-burger[aria-expanded='true'] .icon--menu {
    display: none;
  }
  .nav-burger[aria-expanded='true'] .icon--close {
    display: block;
  }

  /* --- Mobile: collapse links into a dropdown panel --- */
  @media (max-width: 640px) {
    .uishell__inner {
      gap: var(--sp-3);
    }
    .nav-burger {
      display: inline-flex;
    }
    .uishell__right {
      margin-left: auto;
    }
    .nav {
      position: absolute;
      top: var(--shell-h);
      left: 0;
      right: 0;
      margin-left: 0;
      flex-direction: column;
      align-items: stretch;
      gap: var(--sp-1);
      padding: var(--sp-3) var(--gutter) var(--sp-4);
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      box-shadow: var(--shadow-sm);
      display: none;
    }
    .nav[data-open] {
      display: flex;
    }
    .nav__link {
      padding: var(--sp-3) var(--sp-4);
      font-size: 1.0625rem;
    }
  }
</style>
