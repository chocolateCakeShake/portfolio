---
const links = [
  { href: '/', label: 'Home' },
  { href: '/work', label: 'Work' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="uishell">
  <div class="uishell__inner">
    <a class="wordmark" href="/" aria-label="Home">Abdullah</a>

    <nav class="nav" aria-label="Primary">
      {
        links.map((l) => (
          <a
            class="nav__link"
            href={l.href}
            aria-current={isActive(l.href) ? 'page' : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <button
      class="theme-toggle"
      type="button"
      aria-label="Toggle color theme"
      data-theme-toggle
    >
      <svg class="icon icon--sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
      </svg>
      <svg class="icon icon--moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
      </svg>
    </button>
  </div>
</header>

<script is:inline>
  (() => {
    const btn = document.querySelector('[data-theme-toggle]');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const root = document.documentElement;
      const current =
        root.getAttribute('data-theme') ||
        (window.matchMedia('(prefers-color-scheme: dark)').matches
          ? 'dark'
          : 'light');
      const next = current === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
    });
  })();
</script>

<style>
  .uishell {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--shell-h);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .uishell__inner {
    height: 100%;
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: flex;
    align-items: center;
    gap: var(--sp-6);
  }

  .wordmark {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1.375rem;
    color: var(--ink);
    letter-spacing: -0.02em;
  }
  .wordmark:hover {
    text-decoration: none;
    color: var(--accent-ix);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: var(--sp-1);
    margin-left: auto;
  }
  .nav__link {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 500;
    color: var(--muted);
    padding: var(--sp-2) var(--sp-4);
    border-radius: var(--radius);
    transition: color var(--dur) var(--ease), background var(--dur) var(--ease);
  }
  .nav__link:hover {
    color: var(--ink);
    background: var(--surface);
    text-decoration: none;
  }
  /* Active tab — a clear highlighted pill (reads for any audience) */
  .nav__link[aria-current='page'] {
    color: var(--accent-ix);
    background: var(--accent-wash);
    font-weight: 600;
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    background: transparent;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    color: var(--muted);
    cursor: pointer;
    transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .theme-toggle:hover {
    color: var(--ink);
    border-color: var(--ink);
  }
  .icon {
    display: block;
  }
  /* Show the icon for the theme you'd switch TO: light mode → moon, dark → sun */
  .icon--sun {
    display: none;
  }
  :root[data-theme='dark'] .icon--sun {
    display: block;
  }
  :root[data-theme='dark'] .icon--moon {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .icon--sun {
      display: block;
    }
    :root:not([data-theme='light']) .icon--moon {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .uishell__inner {
      gap: var(--sp-3);
    }
    .nav__link {
      padding-inline: var(--sp-3);
    }
  }
</style>
